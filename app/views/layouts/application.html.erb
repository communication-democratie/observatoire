<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <%= render "seo" %>
  </head>
  <body class="<%= body_classes %>">
    <%= render "top" %>
    <%= render "header" %>
    <%= render "notice" %>
    <main>
      <div class="hero mb-2 mb-md-5 pb-4 pb-md-5">
        <%= render "breadcrumb" %>
        <%= yield :hero %>
      </div>
      <% without_container = content_for(:yield_without_container) %>
      <div <%= "class=container" unless without_container %>>
        <%= yield %>
      </div>
    </main>
    <%= render "footer" %>
    <%= javascript_include_tag "application" %>
    <%= render "bugsnag" %>
    <%= render "plausible" %>
  </body>
</html>
