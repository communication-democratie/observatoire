<%
is_home = controller_name == 'pages' && action_name == 'index'
%>

<footer class="mt-5">
  <% if is_home %>
    <div class="container py-4 pb-5 py-lg-5">
      <div class="footer-about mb-3 pb-3 mb-lg-5 pb-lg-5">
        <h2><%= t ('front.footer.about.title') %></h2>
        <div class="row mt-4">
          <p class="summary col-lg-6"><%= t ('front.footer.about.summary') %></p>
          <div class="col-lg-6">
            <% t('front.footer.about.text').each do |paragraph| %>
              <p><%= paragraph %></p>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <%= render 'shortcodes/members', bw: true %>
  <% end %>
  <div class="footer-menu pt-5 pb-5">
    <div class="container py-md-5">
      <div class="row">
        <div class="col-md-8">
          <a href="/">
            <%= image_tag 'logo-blanc.svg', alt: t('front.website'), class: 'logo' %>
          </a>
          <%= render_navigation(context: :footer, dropdown: false) %>
        </div>
        <div class="col-md-4 footer-newsletter">
          <%= render "newsletter-form" %>
        </div>
      </div>
    </div>
    <div class="container d-md-flex gap-4 mt-5 align-items-md-end justify-content-md-between">
      <div class="footer-legal">
        <p class="small"><%= t('front.footer.legals.copyright', year: Date.current.year) %></p>
        <p class="small"><a href="/mentions-legales-et-politique-de-confidentialite" title="<%= t ('front.footer.legals.title') %>"><%= t ('front.footer.legals.title') %></a></p>
        <p class="small"><%= t('front.footer.legals.credit_html') %></p>
        <p class="small"><a href="https://github.com/communication-democratie/observatoire" title="<%= t ('front.footer.legals.github') %>"><%= t ('front.footer.legals.github') %></a></p>
        <p class="small"><a href="https://www.ecoindex.fr" target="_blank">Ecoindex A</a></p>
      </div>
      <div class="footer-socials mt-5 pb-1">
        <a href="mailto:contact@observatoirecitoyenpublicite.org" class="email" target="_blank" rel="noreferrer noopener" title="<%= t "front.a11y.external_link", name: t('front.footer.socials.email') %>"><span>Email</span></a>
        <a href="https://mastodon.social/@observatoirecitoyenpublicite@piaille.fr " class="mastodon" target="_blank" rel="noreferrer noopener" title="<%= t "front.a11y.external_link", name: t('front.footer.socials.mastodon') %>"><span>Mastodon</span></a>
        <a href="https://bsky.app/profile/observatoirecitoyenpublicite.org" class="bluesky" target="_blank" rel="noreferrer noopener" title="<%= t "front.a11y.external_link", name: t('front.footer.socials.bluesky') %>"><span>Bluesky</span></a>
        <a href="https://www.linkedin.com/company/observatoire-citoyen-publicite" class="linkedin" target="_blank" rel="noreferrer noopener" title="<%= t "front.a11y.external_link", name: t('front.footer.socials.linkedin') %>"><span>Linkedin</span></a>
        <a href="https://www.instagram.com/observatoire_citoyen_publicite/" class="instagram" target="_blank" rel="noreferrer noopener" title="<%= t "front.a11y.external_link", name: t('front.footer.socials.instagram') %>"><span>Instagram</span></a>
        <a href="https://www.facebook.com/observatoirecitoyenpublicite/" class="facebook" target="_blank" rel="noreferrer noopener" title="<%= t "front.a11y.external_link", name: t('front.footer.socials.facebook') %>"><span>Facebook</span></a>
      </div>
    </div>
  </div>
</footer>
