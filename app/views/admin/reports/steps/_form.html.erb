
<%= simple_form_for step, url: step.persisted? ? admin_reports_step_path(step) : admin_reports_steps_path do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <%= f.input :title %>
  <%= f.input :description %>
  <%= f.input :parent_id,
              collection: step.available_parents.map { |parent, depth| ["#{'— ' * depth}#{parent}", parent.id] },
              include_blank: :translate %>
  <%= f.input :position %>
  <%= f.input :ignore_in_front %>

  <%= f.button :submit, t('admin.save'), class: button_classes %>
<% end %>
